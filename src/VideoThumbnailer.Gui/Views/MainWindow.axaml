<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoThumbnailer.Gui.ViewModels"
        xmlns:settings="using:VideoThumbnailer.Core.Settings"
        xmlns:l="using:VideoThumbnailer.Gui.Localization"
        xmlns:c="using:VideoThumbnailer.Gui.Controls"
        x:Class="VideoThumbnailer.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Video-Thumbnailer"
        Icon="/Assets/app.ico"
        Background="{DynamicResource PageBrush}"
        Width="1320" Height="840" MinWidth="820" MinHeight="620"
        DragDrop.AllowDrop="True">

  <!-- Layout "Leuchttisch": queue | live preview | settings, footer with ffmpeg status and run controls. -->
  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="Auto,*,350">

      <!-- ================= Queue (collapsed: narrow strip) ================= -->
      <Border x:Name="QueueStrip" Grid.Column="0" Width="52" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"
              IsVisible="{Binding IsQueueCollapsed}">
        <DockPanel Margin="0,8">
          <StackPanel DockPanel.Dock="Top" Spacing="4" HorizontalAlignment="Center">
            <Button x:Name="ExpandQueueButton" Classes="icon" Content="»" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="{l:T QueueExpand}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Jobs.Count}" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Center" ToolTip.Tip="{Binding QueueTitle}" />
            <Button Content="+" Command="{Binding AddFilesCommand}" Classes="accent" Width="36" HorizontalContentAlignment="Center" ToolTip.Tip="{l:T AddFiles}" />
            <Button Width="36" Command="{Binding AddFolderCommand}" ToolTip.Tip="{l:T AddFolder}" HorizontalContentAlignment="Center">
              <PathIcon Width="14" Height="14" Data="M2,5 C2,3.9 2.9,3 4,3 L9,3 L11,5 L20,5 C21.1,5 22,5.9 22,7 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 Z" />
            </Button>
            <Button Width="36" Command="{Binding AddUrlCommand}" ToolTip.Tip="{l:T AddUrl}" HorizontalContentAlignment="Center">
              <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding $parent[Button].Foreground}"
                    Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M2.5,9 L21.5,9 M2.5,15 L21.5,15 M12,2 C7.5,6.5 7.5,17.5 12,22 M12,2 C16.5,6.5 16.5,17.5 12,22" />
            </Button>
          </StackPanel>
          <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jobs}" HorizontalAlignment="Center">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:JobViewModel">
                  <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.err="{Binding IsError}" Classes.run="{Binding IsActive}"
                           Width="9" Height="9" Margin="0,3" ToolTip.Tip="{Binding FileName}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ================= Queue ================= -->
      <Border x:Name="QueuePanel" Grid.Column="0" Width="280" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"
              IsVisible="{Binding !IsQueueCollapsed}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="14,10,6,4">
            <TextBlock Text="{Binding QueueTitle}" Classes="caption" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="CollapseQueueButton" Classes="icon" Content="«" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="{l:T QueueCollapse}" />
            <Button Grid.Column="1" Classes="icon" Content="⋯" ToolTip.Tip="{l:T QueueMenuTip}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{l:T RemoveSelected}" Command="{Binding RemoveSelectedCommand}" />
                  <MenuItem Header="{l:T ClearFinished}" Command="{Binding ClearFinishedCommand}" />
                  <MenuItem Header="{l:T ClearAll}" Command="{Binding ClearAllCommand}" />
                  <MenuItem Header="{l:T RetryFailed}" Command="{Binding RetryFailedCommand}" />
                  <Separator />
                  <MenuItem Header="{l:T SortByName}" Command="{Binding SortCommand}" CommandParameter="name" />
                  <MenuItem Header="{l:T SortByFolder}" Command="{Binding SortCommand}" CommandParameter="folder" />
                  <MenuItem Header="{l:T SortBySize}" Command="{Binding SortCommand}" CommandParameter="size" />
                  <MenuItem Header="{l:T SortByStatus}" Command="{Binding SortCommand}" CommandParameter="status" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <StackPanel DockPanel.Dock="Top" Margin="14,2,14,8" Spacing="6">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
              <Button Content="{l:T AddFilesShort}" Command="{Binding AddFilesCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" Content="{l:T AddFolderShort}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="2" x:Name="AddUrlButton" Command="{Binding AddUrlCommand}" ToolTip.Tip="{l:T AddUrl}" Width="36" HorizontalContentAlignment="Center" Padding="0">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding $parent[Button].Foreground}"
                    Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M2.5,9 L21.5,9 M2.5,15 L21.5,15 M12,2 C7.5,6.5 7.5,17.5 12,22 M12,2 C16.5,6.5 16.5,17.5 12,22" />
              </Button>
            </Grid>
            <CheckBox Content="{l:T IncludeSubfolders}" IsChecked="{Binding Recursive}" />
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" Margin="14,8,14,14" Height="48">
            <Rectangle Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
            <TextBlock Text="{l:T DropZone}" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0" />
          </Grid>

          <Grid>
            <ListBox x:Name="QueueList" Classes="queue" ItemsSource="{Binding Jobs}" SelectionMode="Multiple,Toggle"
                     Background="Transparent" SelectionChanged="OnQueueSelectionChanged" DoubleTapped="OnQueueDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JobViewModel">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*" Background="Transparent" ToolTip.Tip="{Binding ShownPath}">
                    <DockPanel Grid.ColumnSpan="3">
                      <TextBlock DockPanel.Dock="Right" Text="✎" Classes="caption" Margin="6,0,0,0" IsVisible="{Binding HasManualTimes}" ToolTip.Tip="{Binding ManualTimesText}" />
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Ellipse Grid.Row="1" Classes="dot" Classes.ok="{Binding IsOk}" Classes.err="{Binding IsError}" Classes.run="{Binding IsActive}"
                             Width="6" Height="6" VerticalAlignment="Center" Margin="0,4,6,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="status" Classes.ok="{Binding IsOk}" Classes.err="{Binding IsError}" Classes.run="{Binding IsActive}"
                               Text="{Binding StatusText}" Margin="0,4,8,0" />
                    <ProgressBar Grid.Row="1" Grid.Column="2" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4" MinWidth="40"
                                 VerticalAlignment="Center" Margin="0,4,0,0" IsVisible="{Binding IsActive}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Details}" Classes="hint" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{l:T DropHere}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="20" IsHitTestVisible="False"
                       IsVisible="{Binding !Jobs.Count}" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- ================= Preview ================= -->
      <DockPanel Grid.Column="1" Background="{DynamicResource TableBrush}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="18,8,12,0">
          <TextBlock Text="{l:T PreviewLabel}" Classes="caption" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="ResetManualTimesButton" Classes="icon" Content="{Binding PreviewManualTimesText}" Command="{Binding ResetManualTimesCommand}"
                  ToolTip.Tip="{l:T ManualTimesResetTip}" IsVisible="{Binding HasPreviewManualTimes}" Margin="10,0,0,0" FontSize="12" />
          <TextBlock Grid.Column="3" x:Name="PreviewNote" Text="{Binding PreviewNote}" ToolTip.Tip="{Binding PreviewNoteTip}" Classes="caption" VerticalAlignment="Center" Margin="10,0,14,0"
                     IsVisible="{Binding LivePreview}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" ToolTip.Tip="{l:T LivePreviewTip}">
            <TextBlock Text="{l:T LivePreview}" Classes="caption" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="LivePreviewSwitch" IsChecked="{Binding LivePreview}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" x:Name="PreviewCaption" Text="{Binding PreviewCaption}" Classes="caption" HorizontalAlignment="Center" Margin="0,0,0,14"
                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" IsVisible="{Binding LivePreview}" />
        <Grid>
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,16" BoxShadow="0 8 28 0 #40000000" IsVisible="{Binding LivePreview}">
            <Image x:Name="PreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly" PointerPressed="OnPreviewPointerPressed"
                   Classes.editable="{Binding CanEditTiles}" ToolTip.Tip="{l:T PreviewClickTip}" ToolTip.ServiceEnabled="{Binding CanEditTiles}" />
          </Border>
          <StackPanel x:Name="PreviewOff" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="6" IsVisible="{Binding !LivePreview}">
            <TextBlock Text="{l:T LivePreviewOff}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T LivePreviewOffHint}" Classes="hint" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- ================= Settings ================= -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer Padding="16,12,18,16">
          <StackPanel Spacing="4">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <Border Classes="segment">
                <UniformGrid Columns="2">
                  <RadioButton x:Name="SimpleMode" Classes="seg" GroupName="SettingsMode" Content="{l:T ModeSimple}" IsChecked="{Binding IsSimple}" />
                  <RadioButton x:Name="AdvancedMode" Classes="seg" GroupName="SettingsMode" Content="{l:T ModeAdvanced}" IsChecked="{Binding IsAdvanced}" />
                </UniformGrid>
              </Border>
              <Button x:Name="AppSettingsButton" Grid.Column="1" Classes="icon" Content="⚙" Margin="6,0,0,0" ToolTip.Tip="{l:T SettingsTip}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="240" Spacing="6">
                      <TextBlock Text="{l:T Language}" Classes="caption" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Languages}" DisplayMemberBinding="{ReflectionBinding Label}"
                                SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Language, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                      <TextBlock Text="{l:T Theme}" Classes="caption" Margin="0,6,0,0" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Themes}" DisplayMemberBinding="{ReflectionBinding Label}"
                                SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <!-- Preset -->
            <TextBlock Classes="section" Text="{l:T Preset}" Margin="0,10,0,6" />
            <ListBox x:Name="PresetTiles" Classes="presets" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                     Background="Transparent" Margin="0,0,-6,-6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="settings:SheetSettings">
                  <StackPanel Spacing="5" ToolTip.Tip="{Binding Description}">
                    <c:GridGlyph Columns="{Binding Columns}" Rows="{Binding Rows}" Template="{Binding Template}" Width="40" Height="30" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel IsVisible="{Binding IsAdvanced}">
              <Button Content="{l:T SaveAs}" Command="{Binding SavePresetCommand}" Margin="0,4,6,0" />
              <Button Content="{l:T Delete}" Command="{Binding DeletePresetCommand}" Margin="0,4,6,0" />
              <Button Content="{l:T Reset}" Command="{Binding ResetToPresetCommand}" Margin="0,4,6,0" ToolTip.Tip="{l:T ResetTip}" />
              <Button Content="{l:T Import}" Command="{Binding ImportPresetCommand}" Margin="0,4,6,0" />
              <Button Content="{l:T Export}" Command="{Binding ExportPresetCommand}" Margin="0,4,6,0" />
            </WrapPanel>

            <!-- Layout -->
            <TextBlock Classes="section" Text="{l:T Layout}" />
            <ListBox x:Name="LayoutTiles" Classes="presets" ItemsSource="{Binding Settings.Layouts}" SelectedItem="{Binding Settings.SelectedLayout}"
                     Background="Transparent" Margin="0,0,-6,2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LayoutChoice">
                  <StackPanel Spacing="4" ToolTip.Tip="{Binding Tip}">
                    <c:GridGlyph Columns="3" Rows="3" Template="{Binding Template}" Width="32" Height="24" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="{l:T Columns}" IsEnabled="{Binding Settings.IsPlainGrid}" />
              <NumericUpDown x:Name="ColumnsBox" Grid.Column="1" Value="{Binding Settings.Columns}" Minimum="1" Maximum="50" Increment="1" FormatString="0" IsEnabled="{Binding Settings.IsPlainGrid}" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T Rows}" IsEnabled="{Binding Settings.IsPlainGrid}" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.Rows}" Minimum="1" Maximum="100" Increment="1" FormatString="0" IsEnabled="{Binding Settings.IsPlainGrid}" />
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T SheetSize}" />
              <ComboBox x:Name="FitToScreenBox" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ScreenFits}" DisplayMemberBinding="{ReflectionBinding Label}"
                        SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.FitToScreen, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:T SheetSizeTip}" />
              <TextBlock Grid.Row="3" Classes="label" Text="{l:T SheetWidth}" IsEnabled="{Binding Settings.IsFixedWidth}" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.SheetWidth}" Minimum="100" Maximum="32000" Increment="100" FormatString="0" IsEnabled="{Binding Settings.IsFixedWidth}" />
            </Grid>
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0" IsVisible="{Binding IsAdvanced}">
              <TextBlock Grid.Row="0" Classes="label" Text="{l:T GapMargin}" />
              <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Value="{Binding Settings.Gap}" Minimum="0" Maximum="500" FormatString="0" ShowButtonSpinner="False" />
                <NumericUpDown Grid.Column="1" Value="{Binding Settings.Margin}" Minimum="0" Maximum="500" FormatString="0" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T TimelineFlow}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Orders}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Order, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T SkipStartEnd}" />
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Value="{Binding Settings.SkipStartPercent}" Minimum="0" Maximum="45" Increment="0.5" FormatString="0.#" ShowButtonSpinner="False" />
                <NumericUpDown Grid.Column="1" Value="{Binding Settings.SkipEndPercent}" Minimum="0" Maximum="45" Increment="0.5" FormatString="0.#" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Grid.Row="3" Classes="label" Text="{l:T Background}" />
              <c:ColorField x:Name="BackgroundColorField" Grid.Row="3" Grid.Column="1" Text="{Binding Settings.BackgroundColor}" />
              <TextBlock Grid.Row="4" Classes="label" Text="{l:T BackgroundImage}" />
              <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <TextBox x:Name="BackgroundImageBox" Text="{Binding Settings.BackgroundImagePath}" PlaceholderText="{l:T BackgroundImageNone}" ToolTip.Tip="{Binding Settings.BackgroundImagePath}" />
                <Button x:Name="PickBackgroundImageButton" Grid.Column="1" Content="…" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding PickBackgroundImageCommand}" ToolTip.Tip="{l:T BackgroundImagePick}" />
                <Button Grid.Column="2" Content="✕" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding ClearBackgroundImageCommand}" IsEnabled="{Binding Settings.HasBackgroundImage}" ToolTip.Tip="{l:T BackgroundImageClear}" />
              </Grid>
              <TextBlock Grid.Row="5" Classes="label" Text="{l:T BackgroundImageMode}" IsEnabled="{Binding Settings.HasBackgroundImage}" />
              <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,52" ColumnSpacing="6" IsEnabled="{Binding Settings.HasBackgroundImage}">
                <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.BackgroundModes}" DisplayMemberBinding="{ReflectionBinding Label}"
                          SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.BackgroundImageMode, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:T BackgroundImageModeTip}" />
                <NumericUpDown Grid.Column="1" Value="{Binding Settings.BackgroundImageOpacity}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0#"
                               ShowButtonSpinner="False" ToolTip.Tip="{l:T BackgroundImageOpacityTip}" />
              </Grid>
              <TextBlock Grid.Row="6" Classes="label" Text="{l:T FontFamily}" />
              <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding Settings.FontFamily}" PlaceholderText="{l:T FontFamilyPlaceholder}" />
                <Button x:Name="PickFontButton" Grid.Column="1" Content="…" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding PickFontCommand}" ToolTip.Tip="{l:T FontPickerTitle}" />
              </Grid>
              <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="{l:T PortraitSwap}" IsChecked="{Binding Settings.PortraitSwapGrid}" />
              <CheckBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="SkipBlackCheck" Content="{l:T SkipBlackFrames}" ToolTip.Tip="{l:T SkipBlackFramesTip}" IsChecked="{Binding Settings.SkipBlackFrames}" />
              <TextBlock Grid.Row="9" Classes="label" Text="{l:T BlackSearch}" IsEnabled="{Binding Settings.SkipBlackFrames}" />
              <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding Settings.BlackFrameSearchSeconds}" Minimum="0.5" Maximum="30" Increment="0.5" FormatString="0.#"
                             IsEnabled="{Binding Settings.SkipBlackFrames}" />
            </Grid>

            <Border Classes="divider" />

            <!-- Timestamps -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="{l:T ShowTimestampsShort}" ToolTip.Tip="{l:T ShowTimestamps}" />
              <ToggleSwitch x:Name="TimestampSwitch" Grid.Column="1" IsChecked="{Binding Settings.TimestampEnabled}" OnContent="" OffContent="" MinWidth="0" />
            </Grid>
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,2,0,8" IsEnabled="{Binding Settings.TimestampEnabled}" IsVisible="{Binding IsAdvanced}">
              <TextBlock Classes="label" Text="{l:T Position}" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimestampPositions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.TimestampPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T FontSize}" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.TimestampFontSize}" Minimum="4" Maximum="400" FormatString="0" />
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T Color}" />
              <c:ColorField x:Name="TimestampColorField" Grid.Row="2" Grid.Column="1" Text="{Binding Settings.TimestampColor}" />
              <TextBlock Grid.Row="3" Classes="label" Text="{l:T Opacity}" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.TimestampOpacity}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0#" />
              <TextBlock Grid.Row="4" Classes="label" Text="{l:T Outline}" />
              <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Settings.TimestampOutline}" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.#" />
              <TextBlock Grid.Row="5" Classes="label" Text="{l:T OutlineColor}" />
              <c:ColorField x:Name="OutlineColorField" Grid.Row="5" Grid.Column="1" Text="{Binding Settings.TimestampOutlineColor}" />
              <CheckBox Grid.Row="6" Content="{l:T DropShadow}" IsChecked="{Binding Settings.TimestampShadow}" />
              <c:ColorField x:Name="ShadowColorField" Grid.Row="6" Grid.Column="1" Text="{Binding Settings.TimestampShadowColor}" IsEnabled="{Binding Settings.TimestampShadow}" ToolTip.Tip="{l:T ShadowColor}" />
              <CheckBox x:Name="MillisecondsCheck" Grid.Row="7" Grid.ColumnSpan="2" Content="{l:T Milliseconds}" IsChecked="{Binding Settings.TimestampMilliseconds}" />
            </Grid>

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="{l:T ShowHeaderShort}" ToolTip.Tip="{l:T ShowHeader}" />
              <ToggleSwitch x:Name="HeaderSwitch" Grid.Column="1" IsChecked="{Binding Settings.HeaderEnabled}" OnContent="" OffContent="" MinWidth="0" />
            </Grid>
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,2,0,0" IsEnabled="{Binding Settings.HeaderEnabled}" IsVisible="{Binding IsAdvanced}">
              <TextBlock Classes="label" Text="{l:T Position}" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.HeaderPositions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.HeaderPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T HeaderFontSize}" />
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Value="{Binding Settings.HeaderTitleFontSize}" Minimum="4" Maximum="400" FormatString="0" ShowButtonSpinner="False" />
                <NumericUpDown Grid.Column="1" Value="{Binding Settings.HeaderFontSize}" Minimum="4" Maximum="400" FormatString="0" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T HeaderTitleColor}" />
              <c:ColorField x:Name="HeaderTitleColorField" Grid.Row="2" Grid.Column="1" Text="{Binding Settings.HeaderTitleColor}" />
              <TextBlock Grid.Row="3" Classes="label" Text="{l:T HeaderTextColor}" />
              <c:ColorField x:Name="HeaderColorField" Grid.Row="3" Grid.Column="1" Text="{Binding Settings.HeaderColor}" />
              <TextBlock Grid.Row="4" Classes="label" Text="{l:T SheetLanguage}" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.SheetLanguages}" DisplayMemberBinding="{ReflectionBinding Label}"
                        SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.SheetLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBox Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Settings.HeaderTemplate}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="90" FontFamily="monospace" Margin="0,4,0,0" />
              <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Classes="hint" Text="{Binding Settings.PlaceholderHelp}" />
            </Grid>

            <!-- Output: format buttons, quality slider, location -->
            <TextBlock Classes="section" Text="{l:T Output}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock Classes="label" Text="{l:T Animated}" ToolTip.Tip="{l:T AnimatedTip}" />
              <ToggleSwitch x:Name="AnimatedSwitch" Grid.Column="1" IsChecked="{Binding Settings.Animated}" OnContent="" OffContent="" MinWidth="0" />
            </Grid>
            <UniformGrid Columns="3" ColumnSpacing="6" IsVisible="{Binding Settings.Animated}">
              <RadioButton x:Name="FormatMp4" Classes="choice" GroupName="AnimationFormat" Content="MP4" IsChecked="{Binding Settings.IsMp4}" />
              <RadioButton x:Name="FormatWebm" Classes="choice" GroupName="AnimationFormat" Content="WebM" IsChecked="{Binding Settings.IsWebm}" />
              <RadioButton x:Name="FormatGif" Classes="choice" GroupName="AnimationFormat" Content="GIF" IsChecked="{Binding Settings.IsGif}" />
            </UniformGrid>
            <Grid ColumnDefinitions="*,190" RowDefinitions="Auto,Auto" RowSpacing="6" Margin="0,6,0,0" IsVisible="{Binding Settings.Animated}">
              <TextBlock Classes="label" Text="{l:T ClipSeconds}" />
              <NumericUpDown Grid.Column="1" Value="{Binding Settings.ClipSeconds}" Minimum="0.5" Maximum="30" Increment="0.5" FormatString="0.#" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T AnimationFps}" IsVisible="{Binding IsAdvanced}" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.AnimationFps}" Minimum="1" Maximum="60" Increment="1" FormatString="0" IsVisible="{Binding IsAdvanced}" />
            </Grid>
            <UniformGrid Columns="3" ColumnSpacing="6" IsVisible="{Binding Settings.IsStill}">
              <RadioButton x:Name="FormatJpeg" Classes="choice" GroupName="OutputFormat" Content="JPG" IsChecked="{Binding Settings.IsJpeg}" />
              <RadioButton x:Name="FormatPng" Classes="choice" GroupName="OutputFormat" Content="PNG" IsChecked="{Binding Settings.IsPng}" />
              <RadioButton x:Name="FormatWebp" Classes="choice" GroupName="OutputFormat" Content="WebP" IsChecked="{Binding Settings.IsWebp}" />
            </UniformGrid>
            <Grid ColumnDefinitions="Auto,*,36" Margin="0,6,0,0" IsEnabled="{Binding Settings.HasQuality}">
              <TextBlock Classes="label" Text="{l:T Quality}" />
              <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding Settings.QualityValue}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Settings.Quality, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
            </Grid>
            <Grid ColumnDefinitions="*,190" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,4,0,0">
              <TextBlock Classes="label" Text="{l:T SaveTo}" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Locations}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Location, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T OutputFolder}" IsVisible="{Binding Settings.IsOutputFolder}" />
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding Settings.IsOutputFolder}">
                <TextBox Text="{Binding Settings.OutputFolder}" />
                <Button Grid.Column="1" Content="…" Command="{Binding BrowseOutputFolderCommand}" Margin="4,0,0,0" />
              </Grid>
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T SubfolderName}" IsVisible="{Binding Settings.IsSubfolder}" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.SubfolderName}" IsVisible="{Binding Settings.IsSubfolder}" />
            </Grid>
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0" IsVisible="{Binding IsAdvanced}">
              <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="{l:T KeepStructure}" IsChecked="{Binding Settings.KeepFolderStructure}" IsVisible="{Binding Settings.IsOutputFolder}" />
              <TextBlock Grid.Row="1" Classes="label" Text="{l:T FileNamePattern}" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.FileNamePattern}" ToolTip.Tip="{}{name} {ext} {preset} {cols} {rows} {date} {time}" />
              <TextBlock Grid.Row="2" Classes="label" Text="{l:T IfFileExists}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.OverwriteModes}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Overwrite, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="{l:T SaveFrames}" IsChecked="{Binding Settings.SaveFrames}" IsEnabled="{Binding Settings.IsStill}" />
            </Grid>

            <!-- Processing (advanced) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAdvanced}">
              <TextBlock Classes="section" Text="{l:T Processing}" />
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Classes="label" Text="{l:T FfmpegProcesses}" />
                <NumericUpDown x:Name="ParallelProcesses" Grid.Column="1" Value="{Binding MaxParallelProcesses}" Minimum="1" Maximum="64" FormatString="0" />
                <TextBlock Grid.Row="1" Classes="label" Text="{l:T VideosInParallel}" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxParallelVideos}" Minimum="1" Maximum="32" FormatString="0" />
              </Grid>

              <!-- ffmpeg (advanced; simple mode shows status and download in the footer) -->
              <TextBlock Classes="section" Text="{l:T Ffmpeg}" />
              <TextBlock Text="{Binding Ffmpeg.StatusLine}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Ffmpeg.DetailLine}" Classes="hint" />
              <WrapPanel IsVisible="{Binding Ffmpeg.CanDownload}">
                <Button Content="{Binding Ffmpeg.InstallButtonText}" Command="{Binding Ffmpeg.InstallOrUpdateCommand}" Margin="0,4,6,0" />
                <Button Content="{l:T FfmpegCheckUpdate}" Command="{Binding Ffmpeg.CheckForUpdateCommand}" Margin="0,4,6,0" />
              </WrapPanel>
              <CheckBox Content="{l:T FfmpegWeekly}" IsChecked="{Binding Ffmpeg.CheckUpdatesAutomatically}" IsVisible="{Binding Ffmpeg.CanDownload}" />
              <TextBlock Classes="hint" Text="{Binding Ffmpeg.SourceLine}" />
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <TextBox Text="{Binding Ffmpeg.CustomDirectory}" PlaceholderText="{l:T FfmpegCustomPlaceholder}" />
                <Button Grid.Column="1" Content="…" Command="{Binding Ffmpeg.BrowseCustomDirectoryCommand}" Margin="4,0,0,0" />
                <Button Grid.Column="2" Content="✕" Command="{Binding Ffmpeg.ClearCustomDirectoryCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:T FfmpegClearCustomTip}" />
              </Grid>
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:T SimpleHint}" Margin="0,18,0,0" IsVisible="{Binding IsSimple}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================= Footer ================= -->
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
        <Border Background="{DynamicResource SunkenBrush}" CornerRadius="13" Padding="10,4" VerticalAlignment="Center"
                ToolTip.Tip="{Binding Ffmpeg.DetailLine}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Classes.ok="{Binding Ffmpeg.IsReady}" Classes.err="{Binding !Ffmpeg.IsReady}" Width="7" Height="7" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Ffmpeg.StatusLine}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <Button x:Name="FooterFfmpegDownload" Content="{Binding Ffmpeg.InstallButtonText}" Command="{Binding Ffmpeg.InstallOrUpdateCommand}"
                  IsVisible="{Binding Ffmpeg.ShowFooterDownload}" />
          <ProgressBar Value="{Binding Ffmpeg.DownloadPercent}" Minimum="0" Maximum="100" Height="4" MinWidth="120" IsVisible="{Binding Ffmpeg.IsBusy}" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
          <TextBlock Text="{Binding StatusText}" Classes="caption" TextTrimming="CharacterEllipsis" />
          <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="100" Height="6" />
        </StackPanel>
        <Button Grid.Column="3" Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" MinWidth="90" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="{l:T Cancel}" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="5" x:Name="StartButton" Content="{l:T StartAll}" Command="{Binding StartCommand}" Classes="go" MinWidth="120" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
