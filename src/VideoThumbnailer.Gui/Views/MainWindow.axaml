<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoThumbnailer.Gui.ViewModels"
        xmlns:settings="using:VideoThumbnailer.Core.Settings"
        xmlns:l="using:VideoThumbnailer.Gui.Localization"
        x:Class="VideoThumbnailer.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Video-Thumbnailer"
        Icon="/Assets/app.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        DragDrop.AllowDrop="True">

  <Grid ColumnDefinitions="*,Auto,450">

    <!-- ================= Queue ================= -->
    <DockPanel Grid.Column="0" Margin="10">
      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="{l:T AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,6,6" />
        <Button Content="{l:T AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,6,6" />
        <CheckBox Content="{l:T IncludeSubfolders}" IsChecked="{Binding Recursive}" Margin="4,0,12,6" />
        <Button Content="{l:T RemoveSelected}" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,6" />
        <Button Content="{l:T ClearFinished}" Command="{Binding ClearFinishedCommand}" Margin="0,0,6,6" />
        <Button Content="{l:T ClearAll}" Command="{Binding ClearAllCommand}" Margin="0,0,6,6" />
        <Button Content="{l:T RetryFailed}" Command="{Binding RetryFailedCommand}" Margin="0,0,6,6" />
        <Button Content="{l:T Sort}" Margin="0,0,6,6">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{l:T SortByName}" Command="{Binding SortCommand}" CommandParameter="name" />
              <MenuItem Header="{l:T SortByFolder}" Command="{Binding SortCommand}" CommandParameter="folder" />
              <MenuItem Header="{l:T SortBySize}" Command="{Binding SortCommand}" CommandParameter="size" />
              <MenuItem Header="{l:T SortByStatus}" Command="{Binding SortCommand}" CommandParameter="status" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Content="{l:T Start}" Command="{Binding StartCommand}" Classes="accent" MinWidth="90" Margin="0,0,6,0" />
        <Button Grid.Column="1" Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" MinWidth="90" Margin="0,0,6,0" />
        <Button Grid.Column="2" Content="{l:T Cancel}" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,12,0" />
        <ProgressBar Grid.Column="3" Value="{Binding OverallProgress}" Minimum="0" Maximum="100" VerticalAlignment="Center" Height="8" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding StatusText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
      </Grid>

      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
          <ListBox x:Name="QueueList" ItemsSource="{Binding Jobs}" SelectionMode="Multiple,Toggle"

                   Background="Transparent" SelectionChanged="OnQueueSelectionChanged" DoubleTapped="OnQueueDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:JobViewModel">
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" Background="Transparent"
                      ToolTip.Tip="{Binding Job.InputPath}">
                  <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Details}" Classes="hint" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" HorizontalAlignment="Right" />
                  <ProgressBar Grid.Column="1" Grid.Row="1" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                               Height="4" MinWidth="80" Margin="10,4,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{l:T DropHere}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.5" FontSize="18" IsHitTestVisible="False"
                     IsVisible="{Binding !Jobs.Count}" />
        </Grid>
      </Border>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

    <!-- ================= Settings ================= -->
    <ScrollViewer Grid.Column="2" Padding="0,10,14,10">
      <StackPanel DataContext="{Binding}" Spacing="4">

        <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,8">
          <RadioButton x:Name="SimpleMode" GroupName="SettingsMode" Content="{l:T ModeSimple}" IsChecked="{Binding IsSimple}" FontWeight="SemiBold" />
          <RadioButton x:Name="AdvancedMode" GroupName="SettingsMode" Content="{l:T ModeAdvanced}" IsChecked="{Binding IsAdvanced}" FontWeight="SemiBold" />
        </StackPanel>
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,0,0,4">
          <TextBlock Classes="label" Text="{l:T Language}" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.Languages}" DisplayMemberBinding="{ReflectionBinding Label}"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Language, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T Theme}" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.Themes}" DisplayMemberBinding="{ReflectionBinding Label}"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="section" Text="{l:T Preset}" Margin="0,8,0,6" />
        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="settings:SheetSettings">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel IsVisible="{Binding IsAdvanced}">
          <Button Content="{l:T SaveAs}" Command="{Binding SavePresetCommand}" Margin="0,4,6,0" />
          <Button Content="{l:T Delete}" Command="{Binding DeletePresetCommand}" Margin="0,4,6,0" />
          <Button Content="{l:T Reset}" Command="{Binding ResetToPresetCommand}" Margin="0,4,6,0" ToolTip.Tip="{l:T ResetTip}" />
          <Button Content="{l:T Import}" Command="{Binding ImportPresetCommand}" Margin="0,4,6,0" />
          <Button Content="{l:T Export}" Command="{Binding ExportPresetCommand}" Margin="0,4,6,0" />
        </WrapPanel>

        <!-- Layout -->
        <TextBlock Classes="section" Text="{l:T Layout}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBlock Classes="label" Text="{l:T ColumnsRows}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Value="{Binding Settings.Columns}" Minimum="1" Maximum="50" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="×" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Settings.Rows}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T SheetWidth}" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.SheetWidth}" Minimum="100" Maximum="32000" Increment="100" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,4,0,0" IsVisible="{Binding IsAdvanced}">
          <TextBlock Grid.Row="0" Classes="label" Text="{l:T GapMargin}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Value="{Binding Settings.Gap}" Minimum="0" Maximum="500" FormatString="0" Width="110" />
            <NumericUpDown Value="{Binding Settings.Margin}" Minimum="0" Maximum="500" FormatString="0" Width="110" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T TimelineFlow}" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Orders}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Order, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:T SkipStartEnd}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Value="{Binding Settings.SkipStartPercent}" Minimum="0" Maximum="45" Increment="0.5" FormatString="0.#" Width="110" />
            <NumericUpDown Value="{Binding Settings.SkipEndPercent}" Minimum="0" Maximum="45" Increment="0.5" FormatString="0.#" Width="110" />
          </StackPanel>
          <TextBlock Grid.Row="3" Classes="label" Text="{l:T Background}" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.BackgroundColor}" PlaceholderText="#AARRGGBB" />
          <TextBlock Grid.Row="4" Classes="label" Text="{l:T FontFamily}" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.FontFamily}" PlaceholderText="{l:T FontFamilyPlaceholder}" />
          <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="{l:T PortraitSwap}" IsChecked="{Binding Settings.PortraitSwapGrid}" />
        </Grid>

        <!-- Timestamps -->
        <TextBlock Classes="section" Text="{l:T Timestamps}" />
        <CheckBox Content="{l:T ShowTimestamps}" IsChecked="{Binding Settings.TimestampEnabled}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" IsEnabled="{Binding Settings.TimestampEnabled}" IsVisible="{Binding IsAdvanced}">
          <TextBlock Classes="label" Text="{l:T Position}" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimestampPositions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.TimestampPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T FontSize}" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.TimestampFontSize}" Minimum="4" Maximum="400" FormatString="0" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:T ColorOpacity}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding Settings.TimestampColor}" Width="120" PlaceholderText="#AARRGGBB" />
            <NumericUpDown Value="{Binding Settings.TimestampOpacity}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0#" Width="110" />
          </StackPanel>
          <TextBlock Grid.Row="3" Classes="label" Text="{l:T Outline}" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.TimestampOutline}" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.#" />
          <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="{l:T DropShadow}" IsChecked="{Binding Settings.TimestampShadow}" />
        </Grid>

        <!-- Header -->
        <TextBlock Classes="section" Text="{l:T InfoHeader}" />
        <CheckBox Content="{l:T ShowHeader}" IsChecked="{Binding Settings.HeaderEnabled}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" IsEnabled="{Binding Settings.HeaderEnabled}" IsVisible="{Binding IsAdvanced}">
          <TextBlock Grid.Row="4" Classes="label" Text="{l:T SheetLanguage}" />
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.SheetLanguages}" DisplayMemberBinding="{ReflectionBinding Label}"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.SheetLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="label" Text="{l:T Position}" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.HeaderPositions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.HeaderPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T HeaderFontSize}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Value="{Binding Settings.HeaderTitleFontSize}" Minimum="4" Maximum="400" FormatString="0" Width="110" />
            <NumericUpDown Value="{Binding Settings.HeaderFontSize}" Minimum="4" Maximum="400" FormatString="0" Width="110" />
          </StackPanel>
          <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Settings.HeaderTemplate}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="90" FontFamily="monospace" Margin="0,4,0,0" />
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="hint" Text="{Binding Settings.PlaceholderHelp}" />
        </Grid>

        <!-- Output -->
        <TextBlock Classes="section" Text="{l:T Output}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
          <TextBlock Classes="label" Text="{l:T FormatQuality}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Formats}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Format, Mode=TwoWay}" Width="110" />
            <NumericUpDown Value="{Binding Settings.Quality}" Minimum="1" Maximum="100" FormatString="0" Width="110" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T SaveTo}" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Locations}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Location, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:T OutputFolder}" IsVisible="{Binding Settings.IsOutputFolder}" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding Settings.IsOutputFolder}">
            <TextBox Text="{Binding Settings.OutputFolder}" />
            <Button Grid.Column="1" Content="…" Command="{Binding BrowseOutputFolderCommand}" Margin="4,0,0,0" />
          </Grid>
          <TextBlock Grid.Row="4" Classes="label" Text="{l:T SubfolderName}" IsVisible="{Binding Settings.IsSubfolder}" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.SubfolderName}" IsVisible="{Binding Settings.IsSubfolder}" />
        </Grid>
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,4,0,0" IsVisible="{Binding IsAdvanced}">
          <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="{l:T KeepStructure}" IsChecked="{Binding Settings.KeepFolderStructure}" IsVisible="{Binding Settings.IsOutputFolder}" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T FileNamePattern}" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.FileNamePattern}" ToolTip.Tip="{}{name} {ext} {preset} {cols} {rows} {date} {time}" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:T IfFileExists}" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.OverwriteModes}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Settings.Overwrite, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="{l:T SaveFrames}" IsChecked="{Binding Settings.SaveFrames}" />
        </Grid>

        <!-- Processing -->
        <TextBlock Classes="section" Text="{l:T Processing}" IsVisible="{Binding IsAdvanced}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="4" IsVisible="{Binding IsAdvanced}">
          <TextBlock Classes="label" Text="{l:T FfmpegProcesses}" />
          <NumericUpDown x:Name="ParallelProcesses" Grid.Column="1" Value="{Binding MaxParallelProcesses}" Minimum="1" Maximum="64" FormatString="0" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:T VideosInParallel}" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxParallelVideos}" Minimum="1" Maximum="32" FormatString="0" />
        </Grid>

        <!-- ffmpeg -->
        <TextBlock Classes="section" Text="{l:T Ffmpeg}" />
        <TextBlock Text="{Binding Ffmpeg.StatusLine}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Ffmpeg.DetailLine}" Classes="hint" IsVisible="{Binding IsAdvanced}" />
        <ProgressBar Value="{Binding Ffmpeg.DownloadPercent}" Minimum="0" Maximum="100" Height="6" IsVisible="{Binding Ffmpeg.IsBusy}" />
        <WrapPanel IsVisible="{Binding Ffmpeg.CanDownload}">
          <Button Content="{Binding Ffmpeg.InstallButtonText}" Command="{Binding Ffmpeg.InstallOrUpdateCommand}" Margin="0,4,6,0" />
          <Button Content="{l:T FfmpegCheckUpdate}" Command="{Binding Ffmpeg.CheckForUpdateCommand}" Margin="0,4,6,0" IsVisible="{Binding IsAdvanced}" />
        </WrapPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsAdvanced}">
          <CheckBox Content="{l:T FfmpegWeekly}" IsChecked="{Binding Ffmpeg.CheckUpdatesAutomatically}" IsVisible="{Binding Ffmpeg.CanDownload}" />
          <TextBlock Classes="hint" Text="{Binding Ffmpeg.SourceLine}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding IsAdvanced}">
          <TextBox Text="{Binding Ffmpeg.CustomDirectory}" PlaceholderText="{l:T FfmpegCustomPlaceholder}" />
          <Button Grid.Column="1" Content="…" Command="{Binding Ffmpeg.BrowseCustomDirectoryCommand}" Margin="4,0,0,0" />
          <Button Grid.Column="2" Content="✕" Command="{Binding Ffmpeg.ClearCustomDirectoryCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:T FfmpegClearCustomTip}" />
        </Grid>
        <TextBlock Classes="hint" Text="{l:T SimpleHint}" Margin="0,16,0,0" IsVisible="{Binding IsSimple}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
