<?xml version="1.0" encoding="UTF-8"?>
<!-- MIME type for preset files (#33), installed with xdg-mime (see README.md). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-vtpreset+json">
    <comment>Video-Thumbnailer preset</comment>
    <comment xml:lang="de">Video-Thumbnailer-Preset</comment>
    <sub-class-of type="application/json"/>
    <icon name="video-thumbnailer"/>
    <glob pattern="*.vtpreset"/>
    <glob pattern="*.vtpreset.json" weight="60"/>
  </mime-type>
</mime-info>
