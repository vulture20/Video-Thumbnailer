<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Video-Thumbnailer.app; @VERSION@ and @SHORT_VERSION@ are filled in by packaging/macos/make-dmg.sh. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Video-Thumbnailer</string>
  <key>CFBundleDisplayName</key>
  <string>Video-Thumbnailer</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.vulture20.videothumbnailer</string>
  <key>CFBundleExecutable</key>
  <string>VideoThumbnailer</string>
  <key>CFBundleIconFile</key>
  <string>app.icns</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- Preset files (*.vtpreset) open with a double-click (#33); the program gets them as "open file" event. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Video-Thumbnailer Preset</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>app.icns</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.vulture20.videothumbnailer.preset</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.vulture20.videothumbnailer.preset</string>
      <key>UTTypeDescription</key>
      <string>Video-Thumbnailer Preset</string>
      <key>UTTypeIconFile</key>
      <string>app.icns</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>vtpreset</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-vtpreset+json</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (C) 2026 Thorsten Schröpel</string>
</dict>
</plist>
