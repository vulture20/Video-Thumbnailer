<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>Thorsten Schröpel</Authors>
    <Company>Thorsten Schröpel</Company>
    <Product>Video-Thumbnailer</Product>
    <Copyright>Copyright (C) 2026 Thorsten Schröpel</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vulture20/Video-Thumbnailer</RepositoryUrl>
  </PropertyGroup>
</Project>
